<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/c_bg</item>
        <item name="android:colorBackground">@color/c_bg</item>
        <item name="android:textColor">@color/c_text</item>
        <item name="android:textColorPrimary">@color/c_text</item>
        <item name="android:textColorSecondary">@color/c_text_sub</item>
        <item name="android:statusBarColor">@color/c_bar</item>
        <item name="android:navigationBarColor">@color/c_bg</item>
        <item name="android:textColorHint">@color/c_text_dim</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="AppTheme.Splash">
        <item name="android:windowBackground">@color/c_bg_deep</item>
        <item name="android:statusBarColor">@color/c_bg_deep</item>
    </style>

    <style name="AppTheme.Player">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="AppTheme.Dialog">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/c_text</item>
        <item name="android:textSize">@dimen/text_16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/c_text_sub</item>
        <item name="android:textSize">@dimen/text_13dp</item>
    </style>
</resources>
