<?xml version="1.0" encoding="utf-8"?>
<!-- 对齐影视仓「配置地址」弹窗：名称 + 地址 + 选择本地文件 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20.0dip"
    android:background="@drawable/bg_card">

    <TextView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="配置地址"
        android:textSize="@dimen/text_17dp"
        android:textColor="@color/c_text"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        android:text="名称（可选）"
        android:textSize="@dimen/text_12dp"
        android:textColor="@color/c_text_dim" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="fill_parent"
        android:layout_height="44.0dip"
        android:layout_marginTop="6.0dip"
        android:background="@drawable/bg_search_bar"
        android:hint="给这个源起个名字"
        android:inputType="text"
        android:paddingLeft="12.0dip"
        android:paddingRight="12.0dip"
        android:singleLine="true"
        android:textColor="@color/c_text"
        android:textColorHint="@color/c_text_dim"
        android:textSize="@dimen/text_14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:text="接口地址"
        android:textSize="@dimen/text_12dp"
        android:textColor="@color/c_text_dim" />

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="fill_parent"
        android:layout_height="88.0dip"
        android:layout_marginTop="6.0dip"
        android:background="@drawable/bg_search_bar"
        android:gravity="top|left"
        android:hint="http(s)://... 或粘贴完整 JSON"
        android:inputType="textMultiLine|textUri"
        android:padding="12.0dip"
        android:minLines="3"
        android:textColor="@color/c_text"
        android:textColorHint="@color/c_text_dim"
        android:textSize="@dimen/text_13dp" />

    <TextView
        android:id="@+id/btnPickFile"
        android:layout_width="fill_parent"
        android:layout_height="42.0dip"
        android:layout_marginTop="12.0dip"
        android:gravity="center"
        android:textSize="@dimen/text_14dp"
        android:textColor="@color/c_accent"
        android:background="@drawable/bg_btn_gray"
        android:text="选择本地文件" />

    <TextView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:text="支持：TVBox 完整配置 JSON、单接口地址、本地 .json/.txt 文件\n含 JS/爬虫/Python 源时将尝试脚本引擎解析"
        android:textSize="@dimen/text_11dp"
        android:textColor="@color/c_text_dim"
        android:lineSpacingExtra="2.0dip" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0.0dip"
            android:layout_height="44.0dip"
            android:layout_weight="1.0"
            android:gravity="center"
            android:textSize="@dimen/text_15dp"
            android:textColor="@color/c_text"
            android:background="@drawable/bg_btn_gray"
            android:text="取消" />

        <View
            android:layout_width="12.0dip"
            android:layout_height="1.0dip" />

        <TextView
            android:id="@+id/btnOk"
            android:layout_width="0.0dip"
            android:layout_height="44.0dip"
            android:layout_weight="1.0"
            android:gravity="center"
            android:textSize="@dimen/text_15dp"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_accent"
            android:text="确定导入" />
    </LinearLayout>
</LinearLayout>
