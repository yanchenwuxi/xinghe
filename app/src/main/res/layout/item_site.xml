<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="60.0dip"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="14.0dip"
    android:paddingRight="14.0dip"
    android:paddingTop="8.0dip"
    android:paddingBottom="8.0dip">

    <LinearLayout
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_15dp"
            android:textColor="@color/c_text" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.0dip"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textSize="@dimen/text_11dp"
            android:textColor="@color/c_text_dim" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10.0dip"
        android:paddingLeft="10.0dip"
        android:paddingRight="10.0dip"
        android:paddingTop="4.0dip"
        android:paddingBottom="4.0dip"
        android:textSize="@dimen/text_12dp"
        android:textColor="@color/c_accent"
        android:background="@drawable/bg_chip_on"
        android:visibility="gone"
        android:text="@string/site_using" />

    <TextView
        android:id="@+id/btnSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6.0dip"
        android:textSize="@dimen/text_13dp"
        android:textColor="@color/c_accent_blue"
        android:text="@string/site_switch" />
</LinearLayout>
