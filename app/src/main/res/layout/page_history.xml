<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/c_bg">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="44.0dip"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/page_padding"
        android:paddingRight="@dimen/page_padding">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:textSize="@dimen/text_17dp"
            android:textColor="@color/c_text"
            android:text="@string/history_title" />

        <TextView
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6.0dip"
            android:textSize="@dimen/text_13dp"
            android:textColor="@color/c_text_dim"
            android:text="清空" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/segBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/page_padding"
        android:paddingBottom="8.0dip">

        <TextView
            android:id="@+id/segHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="16.0dip"
            android:paddingRight="16.0dip"
            android:paddingTop="6.0dip"
            android:paddingBottom="6.0dip"
            android:layout_marginRight="8.0dip"
            android:textSize="@dimen/text_13dp"
            android:textColor="@color/white"
            android:background="@drawable/bg_chip_on"
            android:text="观看历史" />

        <TextView
            android:id="@+id/segFav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="16.0dip"
            android:paddingRight="16.0dip"
            android:paddingTop="6.0dip"
            android:paddingBottom="6.0dip"
            android:textSize="@dimen/text_13dp"
            android:textColor="@color/c_text_sub"
            android:background="@drawable/bg_chip"
            android:text="我的收藏" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">

        <GridView
            android:id="@+id/grid"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:numColumns="3"
            android:horizontalSpacing="8.0dip"
            android:verticalSpacing="8.0dip"
            android:paddingLeft="@dimen/page_padding"
            android:paddingRight="@dimen/page_padding"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:listSelector="@color/transparent"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:textSize="@dimen/text_14dp"
            android:textColor="@color/c_text_dim"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
