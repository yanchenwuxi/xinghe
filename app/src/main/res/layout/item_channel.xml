<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:minHeight="52.0dip"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="14.0dip"
    android:paddingRight="14.0dip">

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="34.0dip"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_12dp"
        android:textColor="@color/c_text_dim" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="@dimen/text_14dp"
        android:textColor="@color/c_text" />

    <TextView
        android:id="@+id/tvGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_11dp"
        android:textColor="@color/c_text_dim" />
</LinearLayout>
