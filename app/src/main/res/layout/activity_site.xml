<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="@color/c_bg">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="52.0dip"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6.0dip">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:padding="9.0dip"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:textSize="@dimen/text_17dp"
            android:textColor="@color/c_text"
            android:text="@string/site_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_padding"
        android:paddingRight="@dimen/page_padding">

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="fill_parent"
            android:layout_height="44.0dip"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/site_url_hint"
            android:inputType="textUri"
            android:paddingLeft="12.0dip"
            android:paddingRight="12.0dip"
            android:singleLine="true"
            android:textColor="@color/c_text"
            android:textColorHint="@color/c_text_dim"
            android:textSize="@dimen/text_13dp" />

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAdd"
                android:layout_width="0.0dip"
                android:layout_height="42.0dip"
                android:layout_weight="1.0"
                android:gravity="center"
                android:textSize="@dimen/text_15dp"
                android:textColor="@color/white"
                android:background="@drawable/bg_btn_accent"
                android:text="@string/site_add" />

            <TextView
                android:id="@+id/btnLocalFile"
                android:layout_width="0.0dip"
                android:layout_height="42.0dip"
                android:layout_weight="1.0"
                android:layout_marginLeft="10.0dip"
                android:gravity="center"
                android:textSize="@dimen/text_15dp"
                android:textColor="@color/c_text"
                android:background="@drawable/bg_btn_gray"
                android:text="本机文件" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:textSize="@dimen/text_12dp"
            android:textColor="@color/c_text_dim"
            android:text="支持单接口地址、多站点接口（JSON 数组）或本地配置文件" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        android:layout_marginLeft="@dimen/page_padding"
        android:textSize="@dimen/text_13dp"
        android:textColor="@color/c_text_dim"
        android:text="已配置接口" />

    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:layout_marginTop="6.0dip">

        <ListView
            android:id="@+id/list"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:divider="@color/c_divider"
            android:dividerHeight="0.5dip"
            android:scrollbars="none"
            android:listSelector="@color/transparent"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="center"
            android:textSize="@dimen/text_14dp"
            android:textColor="@color/c_text_dim"
            android:text="@string/site_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
